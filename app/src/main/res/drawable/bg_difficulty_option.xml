<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_checked="true">
    <shape android:shape="oval">
      <solid android:color="@color/study_primary" />
      <stroke android:width="1dp" android:color="@color/study_primary" />
    </shape>
  </item>
  <item>
    <shape android:shape="oval">
      <solid android:color="@color/study_surface" />
      <stroke android:width="1dp" android:color="@color/study_border" />
    </shape>
  </item>
</selector>
