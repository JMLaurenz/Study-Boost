<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/study_surface">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
      android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="20dp" android:paddingBottom="28dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginBottom="24dp">
      <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp"
          android:src="@drawable/ic_arrow_back" android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/back_description" />
      <TextView android:id="@+id/tvHeading" android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/add_task"
          android:textSize="28sp" android:textStyle="bold" android:textColor="@color/study_on_surface"
          android:accessibilityHeading="true" />
    </LinearLayout>

    <TextView style="@style/StudyFormLabel" android:text="@string/task_subject" android:labelFor="@id/spinnerSubject" />
    <com.google.android.material.textfield.TextInputLayout style="@style/StudyFormDropdown"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp"
        app:endIconMode="dropdown_menu">
      <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/spinnerSubject"
          android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none"
          android:focusable="false" android:clickable="true" android:hint="@string/choose_subject" android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/tvNeedSubject" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/need_subject" android:textSize="14sp" android:textColor="@color/study_danger"
        android:visibility="gone" android:layout_marginBottom="6dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnManageSubjects"
        style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp"
        android:minHeight="44dp" android:text="@string/manage_subjects" android:textColor="@color/study_primary"
        android:layout_gravity="end" android:layout_marginBottom="10dp" />

    <TextView style="@style/StudyFormLabel" android:text="@string/task_title" android:labelFor="@id/etTaskTitle" />
    <com.google.android.material.textfield.TextInputLayout style="@style/StudyFormField"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
      <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTaskTitle"
          android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine"
          android:maxLines="3" android:hint="@string/task_title_hint" android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView style="@style/StudyFormLabel" android:text="@string/description" android:labelFor="@id/etDescription" />
    <com.google.android.material.textfield.TextInputLayout style="@style/StudyFormField"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
      <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDescription"
          android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine|textCapSentences"
          android:minLines="1" android:maxLines="4" android:gravity="top" android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView style="@style/StudyFormLabel" android:text="@string/due_date" android:labelFor="@id/etDueDate" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/dueDateLayout" style="@style/StudyFormField"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"
        app:startIconDrawable="@drawable/ic_calendar" app:startIconTint="@color/study_on_surface"
        app:endIconDrawable="@drawable/ic_chevron_down" app:endIconMode="custom"
        app:endIconContentDescription="@string/choose_due_date">
      <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/etDueDate"
          android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none"
          android:focusable="false" android:clickable="true" android:hint="@string/due_hint" android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView style="@style/StudyFormLabel" android:text="@string/estimated_hours" android:labelFor="@id/etHours" />
    <com.google.android.material.textfield.TextInputLayout style="@style/StudyFormDropdown"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
        app:startIconDrawable="@drawable/ic_clock" app:startIconTint="@color/study_on_surface" app:endIconMode="dropdown_menu">
      <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/etHours"
          android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none"
          android:focusable="false" android:clickable="true" android:hint="@string/hours_hint" android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <CheckBox android:id="@+id/cbCompleted" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/mark_as_complete" android:layout_marginBottom="18dp" />
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveTask"
        android:layout_width="match_parent" android:layout_height="54dp" android:text="@string/save_task"
        android:textSize="17sp" android:textStyle="bold" app:cornerRadius="17dp" />
  </LinearLayout>
</ScrollView>
