<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/study_surface">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
      android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="20dp" android:paddingBottom="28dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
      <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_arrow_back"
          android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back_description" />
      <TextView android:id="@+id/tvHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
          android:text="@string/study_timer" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/study_on_surface"
          android:accessibilityHeading="true" android:layout_marginStart="8dp" />
    </LinearLayout>
    <TextView android:id="@+id/tvTimerSubjectCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/subject_code"
        android:textSize="15sp" android:textColor="@color/study_on_surface" android:background="@drawable/bg_tag_blue" android:layout_marginBottom="8dp" />
    <TextView android:id="@+id/tvTimerTask" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/task_title"
        android:textSize="25sp" android:textStyle="bold" android:textColor="@color/study_on_surface" />
    <TextView android:id="@+id/tvTimerSubject" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/task_subject"
        android:textSize="16sp" android:textColor="@color/study_muted" android:layout_marginBottom="14dp" />

    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/focus_length" app:endIconMode="dropdown_menu"
        android:layout_marginBottom="14dp">
      <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/etMinutes" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:inputType="none" android:focusable="false" android:clickable="true" android:hint="@string/focus_length" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="260dp">
      <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/timerProgress" android:layout_width="222dp" android:layout_height="222dp"
          android:layout_gravity="center" android:importantForAccessibility="no" android:indeterminate="false" android:max="1000"
          app:indicatorSize="210dp" app:trackThickness="10dp" app:indicatorColor="@color/study_primary" app:trackColor="@color/study_sage" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/tvCountdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/countdown_initial"
            android:textSize="48sp" android:textStyle="bold" android:textColor="@color/study_on_surface" android:contentDescription="@string/countdown_description" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/timer_help" android:textSize="16sp" android:textColor="@color/study_muted" />
      </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/tvTimerState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/timer_ready"
        android:textSize="18sp" android:textStyle="bold" android:gravity="center" android:textColor="@color/study_on_surface" android:layout_marginBottom="4dp" />
    <TextView android:id="@+id/tvElapsedDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/focused_duration"
        android:textSize="15sp" android:gravity="center" android:textColor="@color/study_muted" android:visibility="gone" android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="54dp"
        android:text="@string/start_focus" android:textSize="17sp" android:textStyle="bold" app:icon="@drawable/ic_play" app:iconGravity="textStart"
        app:iconPadding="10dp" app:cornerRadius="18dp" android:layout_marginBottom="10dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnPause" android:layout_width="match_parent" android:layout_height="54dp"
        android:text="@string/pause" android:textSize="17sp" android:textStyle="bold" app:icon="@drawable/ic_pause" app:iconGravity="textStart"
        app:iconPadding="10dp" app:cornerRadius="18dp" android:layout_marginBottom="10dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnFinish" android:layout_width="match_parent" android:layout_height="54dp"
        android:text="@string/finish_save" android:textSize="17sp" android:textStyle="bold" app:icon="@drawable/ic_check" app:iconGravity="textStart"
        app:iconPadding="10dp" app:cornerRadius="18dp" />
  </LinearLayout>
</ScrollView>
