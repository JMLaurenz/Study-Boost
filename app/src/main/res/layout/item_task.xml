<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/study_border" app:strokeWidth="1dp" app:cardBackgroundColor="@color/study_surface">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="14dp">
    <View android:id="@+id/subjectColor" android:layout_width="6dp" android:layout_height="match_parent" android:background="@color/study_blue_tag"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
      <TextView android:id="@+id/tvTaskTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/task_title"
          android:textSize="20sp" android:textStyle="bold" android:textColor="@color/study_on_surface" android:clickable="true" android:focusable="true"
          android:minHeight="48dp" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" />
      <TextView android:id="@+id/tvTaskSubject" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/task_subject"
          android:textSize="14sp" android:textColor="@color/study_on_surface" android:background="@drawable/bg_tag_blue" android:layout_marginBottom="9dp" />
      <TextView android:id="@+id/tvDueBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/due_date"
          android:textSize="14sp" android:textStyle="bold" android:textColor="@color/study_on_surface" android:background="@drawable/bg_tag_amber" android:layout_marginBottom="9dp" />
      <TextView android:id="@+id/tvTaskMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/task_meta"
          android:textSize="14sp" android:textColor="@color/study_on_surface" android:layout_marginBottom="8dp" />
      <TextView android:id="@+id/tvTaskPriority" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/task_priority"
          android:visibility="gone" android:importantForAccessibility="no" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnFocus" android:layout_width="0dp" android:layout_height="46dp"
            android:minHeight="46dp" android:layout_weight="1" android:text="@string/focus" android:textStyle="bold" app:icon="@drawable/ic_play"
            app:iconGravity="textStart" app:iconPadding="8dp" app:cornerRadius="18dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnEdit" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="46dp" android:minHeight="46dp" android:layout_weight="1" android:text="@string/edit"
            android:layout_marginStart="8dp" app:cornerRadius="18dp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnToggle" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp" android:layout_height="44dp" android:minHeight="44dp" android:layout_weight="1" android:text="@string/mark_complete"
            android:textColor="@color/study_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="44dp" android:minHeight="44dp" android:text="@string/delete"
            android:textColor="@color/study_danger" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
