<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Academic Subject"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Subject Code Input -->
    <EditText
        android:id="@+id/etSubjectCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Subject Code (e.g., CS101)"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <!-- Subject Name Input -->
    <EditText
        android:id="@+id/etSubjectName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Subject Name (e.g., Data Structures)"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <!-- Difficulty Rating Input (Scale 1-5) -->
    <EditText
        android:id="@+id/etDifficulty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Difficulty Rating (1 to 5)"
        android:inputType="number"
        android:layout_marginBottom="24dp" />

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSaveSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Subject" />

</LinearLayout>