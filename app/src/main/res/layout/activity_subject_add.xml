<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/study_surface">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
      android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="20dp" android:paddingBottom="28dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginBottom="24dp">
      <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp"
          android:src="@drawable/ic_arrow_back" android:background="?attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/back_description" />
      <TextView android:id="@+id/tvHeading" android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/add_subject"
          android:textSize="28sp" android:textStyle="bold" android:textColor="@color/study_on_surface"
          android:accessibilityHeading="true" />
    </LinearLayout>

    <TextView style="@style/StudyFormLabel" android:text="@string/subject_code" android:labelFor="@id/etSubjectCode" />
    <com.google.android.material.textfield.TextInputLayout style="@style/StudyFormField"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
      <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSubjectCode"
          android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters"
          android:singleLine="true" android:hint="@string/subject_code_hint" android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView style="@style/StudyFormLabel" android:text="@string/subject_name" android:labelFor="@id/etSubjectName" />
    <com.google.android.material.textfield.TextInputLayout style="@style/StudyFormField"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
      <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSubjectName"
          android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords"
          android:singleLine="true" android:hint="@string/subject_name_hint" android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView style="@style/StudyFormLabel" android:text="@string/color_hex" android:labelFor="@id/actColor" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/colorTagLayout" style="@style/StudyFormDropdown"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp"
        app:endIconMode="dropdown_menu">
      <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/actColor"
          android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none"
          android:focusable="false" android:clickable="true" android:hint="@string/color_hint" android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/difficulty"
        android:labelFor="@id/difficultyGroup" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/study_on_surface" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/difficulty_help"
        android:textSize="15sp" android:textColor="@color/study_muted" android:layout_marginTop="2dp" android:layout_marginBottom="12dp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fillViewport="true" android:scrollbars="none" android:layout_marginBottom="10dp">
      <RadioGroup android:id="@+id/difficultyGroup" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:orientation="horizontal" android:gravity="center">
        <RadioButton android:id="@+id/difficulty1" style="@style/StudyDifficultyOption" android:layout_marginEnd="8dp"
            android:text="@string/difficulty_1" android:contentDescription="@string/difficulty_option_1" />
        <RadioButton android:id="@+id/difficulty2" style="@style/StudyDifficultyOption" android:layout_marginEnd="8dp"
            android:text="@string/difficulty_2" android:contentDescription="@string/difficulty_option_2" />
        <RadioButton android:id="@+id/difficulty3" style="@style/StudyDifficultyOption" android:layout_marginEnd="8dp"
            android:text="@string/difficulty_3" android:contentDescription="@string/difficulty_option_3" />
        <RadioButton android:id="@+id/difficulty4" style="@style/StudyDifficultyOption" android:layout_marginEnd="8dp"
            android:text="@string/difficulty_4" android:contentDescription="@string/difficulty_option_4" />
        <RadioButton android:id="@+id/difficulty5" style="@style/StudyDifficultyOption"
            android:text="@string/difficulty_5" android:contentDescription="@string/difficulty_option_5" />
      </RadioGroup>
    </HorizontalScrollView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/difficulty_scale"
        android:textSize="14sp" android:textColor="@color/study_muted" android:layout_marginBottom="28dp" />

    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveSubject"
        android:layout_width="match_parent" android:layout_height="54dp" android:text="@string/save_subject"
        android:textSize="17sp" android:textStyle="bold" app:cornerRadius="17dp" />
  </LinearLayout>
</ScrollView>
